;CapsLock up:: onHyperRepeatedPresses(onRepeatedPress)

; Options
HYPER_KEY := "CapsLock"
HYPER_RESET_TIMEOUT_MS := 500
HYPER_REPEAT_TIMEOUT_MS := 500
HYPER_HOLD_MS := 1000

; Globals
HYPER_KEY_DOWN := "~" . HYPER_KEY
HYPER_KEY_UP := HYPER_KEY . " up"
HYPER_PRIOR_HOTKEY := HYPER_KEY_DOWN
HYPER_PRESS_TICK := 0
HYPER_PRIOR_PRESS_TICK := 0
HYPER_REPEATED_PRESSES := 0


onHyperKeyPress(keyHoldCallback) {
  if (A_PriorHotkey == HYPER_KEY_DOWN)  ; dont keep re-running this on key hold
    return

  global HYPER_PRESS_TICK := A_TickCount
  global HYPER_PRIOR_HOTKEY := A_PriorHotkey

  ; run CapsLockLongHold() when detected long-hold key-down
  ; the key-up will update A_ThisHotkey, so the check is necessary
  KeyWait(HYPER_KEY, "T" (HYPER_HOLD_MS / 1000))
  if (
    A_ThisHotkey == HYPER_KEY_DOWN &&
    A_PriorHotkey == HYPER_KEY_UP &&
    A_TickCount - HYPER_PRESS_TICK >= HYPER_HOLD_MS
  )
    if (!keyHoldCallback()) ; return false to block key-up event
      global HYPER_PRIOR_HOTKEY := HYPER_KEY_DOWN
}


onHyperKeyRepeatedPresses(keyUpCallback) {
  global HYPER_PRESS_TICK, HYPER_REPEATED_PRESSES, HYPER_PRIOR_PRESS_TICK, HYPER_PRIOR_HOTKEY
  ElapsedPressTime := A_TickCount - HYPER_PRESS_TICK
  isPriorHotkey := A_PriorHotkey == HYPER_KEY_DOWN

  ; reset repeated presses if more than ...-ms since prior key-up
  if (!isPriorHotkey || A_TickCount - HYPER_PRIOR_PRESS_TICK > HYPER_RESET_TIMEOUT_MS)
    HYPER_REPEATED_PRESSES := 0

  ; increment repeated presses if pressed for longer than ...-ms between presses
  if (ElapsedPressTime <= HYPER_REPEAT_TIMEOUT_MS)
    HYPER_REPEATED_PRESSES++

  if (isPriorHotkey && HYPER_PRIOR_HOTKEY == HYPER_KEY_UP)
    keyUpCallback(HYPER_REPEATED_PRESSES)

  HYPER_PRIOR_PRESS_TICK := A_TickCount
}
