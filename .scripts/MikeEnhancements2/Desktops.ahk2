#Include "./lib/libVD.ahk2"  ; https://github.com/FuPeiJiang/VD.ahk/tree/v2_port
#Include "./lib/libDesktopsDialog.ahk2"  ;

VD.current_desktopNum := VD.getCurrentDesktopNum()
VD.previous_desktopNum := VD.current_desktopNum
VD.previous_isActive := false

VD.RegisterDesktopNotifications()
VD.DefineProp("CurrentVirtualDesktopChanged", { Call: onDesktopChange })
onDesktopChange(desktopNum_Old, desktopNum_New) {
  VD.current_desktopNum := desktopNum_New
  VD.previous_desktopNum := desktopNum_Old
  SetTrayIcon(VD.previous_isActive)
  VD.previous_isActive := false
}

GotoDesktop(num) {
  if (VD.getCount() < num)
    VD.createUntil(num)
  VD.previous_isActive := true
  VD.goToDesktopNum(num)
}

GotoNextDesktop() {
  VD.animation_on := true
  if (VD.current_desktopNum < VD.getCount())
    GotoDesktop(VD.current_desktopNum + 1)
  VD.animation_on := false
}

GotoPrevDesktop() {
  VD.animation_on := true
  if (VD.current_desktopNum > 1)
    GotoDesktop(VD.current_desktopNum - 1)
  VD.animation_on := false
}

; Quick-switch Desktops
CapsLock & Tab::GotoDesktop(VD.previous_desktopNum)

; Move window to Desktop
CapsLock & `:: OpenDesktopDialog()
CapsLock & m:: OpenDesktopDialog()

; Focus Desktop, CapsLock + {1,2,3,4,5,6}
;F1:: GotoDesktop(1)
;F2:: GotoDesktop(2)
;F3:: GotoDesktop(3)
;F4:: GotoDesktop(4)
;^F1:: F1
;^F2:: F2
;^F3:: F3
;^F4:: F4
SwitchOrMoveToDesktop(num) {
  static locked := false
  if (locked)
    return
  locked := true
  try {
    if GetKeyState("Alt", "P") {
      hwnd := WinExist("A")
      if hwnd
        VD.MoveWindowToDesktopNum(hwnd, Integer(num)).follow()
    } else
      GotoDesktop(num)
  } finally {
    locked := false
  }
}

CapsLock & 1:: SwitchOrMoveToDesktop(1)
CapsLock & 2:: SwitchOrMoveToDesktop(2)
CapsLock & 3:: SwitchOrMoveToDesktop(3)
CapsLock & 4:: SwitchOrMoveToDesktop(4)
CapsLock & 5:: SwitchOrMoveToDesktop(5)

; Windows Task View -- Desktop Switcher
#HotIf WinActive("Task View ahk_class XamlExplorerHostIslandWindow")
  WheelUp:: GotoPrevDesktop()
  WheelDown:: GotoNextDesktop()
#HotIf
