// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "!menu", // All contexts
    "bindings": {
      "shift shift": "file_finder::Toggle",
      "alt-h": "pane::ActivatePrevItem",
      "alt-l": "pane::ActivateNextItem",

      "alt-shift-h": "pane::SwapItemLeft",
      "alt-shift-l": "pane::SwapItemRight",

      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight",

      "ctrl-shift-h": [
        "workspace::MoveItemToPaneInDirection",
        { "direction": "left" }
      ],
      "ctrl-shift-j": [
        "workspace::MoveItemToPaneInDirection",
        { "direction": "down" }
      ],
      "ctrl-shift-k": [
        "workspace::MoveItemToPaneInDirection",
        { "direction": "up" }
      ],
      "ctrl-shift-l": [
        "workspace::MoveItemToPaneInDirection",
        { "direction": "right" }
      ],

      "ctrl-1": ["workspace::ActivatePane", 0],
      "ctrl-2": ["workspace::ActivatePane", 1],
      "ctrl-3": ["workspace::ActivatePane", 2],
      "ctrl-4": ["workspace::ActivatePane", 3],
      "ctrl-5": ["workspace::ActivatePane", 4],
      "ctrl-6": ["workspace::ActivatePane", 5],
      "ctrl-7": ["workspace::ActivatePane", 6],
      "ctrl-8": ["workspace::ActivatePane", 7],
      "ctrl-9": ["workspace::ActivatePane", 8],

      "ctrl-alt-shift-h": "workspace::SwapPaneLeft",
      "ctrl-alt-shift-j": "workspace::SwapPaneDown",
      "ctrl-alt-shift-k": "workspace::SwapPaneUp",
      "ctrl-alt-shift-l": "workspace::SwapPaneRight",

      "ctrl-alt-n": "workspace::NewFile",

      "ctrl-n": null,
      "ctrl-alt-h": null,
      "ctrl-alt-l": null
    }
  },
  {
    "context": "Editor && (vim_mode == normal || vim_mode == visual)",
    "bindings": {
      "shift-h": ["workspace::SendKeystrokes", "g 0"],
      "shift-l": ["workspace::SendKeystrokes", "g _"]
    }
  },
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "s": "outline::Toggle",
      "shift-s": ["workspace::SendKeystrokes", "y s i w"],
      "ctrl-v": ["workspace::SendKeystrokes", "\" + p"]
    }
  },
  {
    "context": "Editor && vim_mode == visual",
    "bindings": {
      "ctrl-c": ["workspace::SendKeystrokes", "\" + y g v"],
      "v": "editor::SelectLargerSyntaxNode",
      ">": ["workspace::SendKeystrokes", "> g v"],
      "<": ["workspace::SendKeystrokes", "< g v"]
    }
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "ctrl-v": ["workspace::SendKeystrokes", "escape \" + p"],
      "ctrl-space": "editor::ShowCompletions",
      "ctrl-shift-space": "zeta::PreviewCompletion"
    }
  },
  {
    "context": "(Editor && vim_mode != visual) && !showing_completions",
    "bindings": {
      "ctrl-n": "editor::ShowCompletions"
    }
  },

  {
    "context": "Editor && !menu",
    "bindings": {
      //"ctrl-c": "editor::Copy", // vim default: return to normal mode
      "ctrl-x": "editor::Cut", // vim default: decrement
      //"ctrl-v": "editor::Paste", // vim default: visual block mode
      "ctrl-y": "vim::Undo", // vim default: line up
      "ctrl-f": "buffer_search::Deploy", // vim default: page down
      //"ctrl-o": "workspace::Open", // vim default: go back
      "ctrl-a": "editor::SelectAll" // vim default: increment
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-v": ["workspace::SendKeystrokes", "escape \" + p a"],
      "ctrl-p": null
    }
  }
]
