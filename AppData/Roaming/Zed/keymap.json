// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "!menu && !(Picker > Editor)", // All contexts
    "bindings": {
      "shift shift": "file_finder::Toggle",
      "alt-h": "pane::ActivatePreviousItem",
      "alt-l": "pane::ActivateNextItem",

      "alt-shift-h": "pane::SwapItemLeft",
      "alt-shift-l": "pane::SwapItemRight",

      "ctrl-w c": "pane::CloseActiveItem",
      "ctrl-w x": "pane::CloseActiveItem",
      "ctrl-w shift-x": "pane::CloseAllItems",

      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight",

      "ctrl-alt-h": [
        "workspace::MoveItemToPaneInDirection",
        { "direction": "left" }
      ],
      "ctrl-alt-j": [
        "workspace::MoveItemToPaneInDirection",
        { "direction": "down" }
      ],
      "ctrl-alt-k": [
        "workspace::MoveItemToPaneInDirection",
        { "direction": "up" }
      ],
      "ctrl-alt-l": [
        "workspace::MoveItemToPaneInDirection",
        { "direction": "right" }
      ],

      "ctrl-1": ["workspace::ActivatePane", 0],
      "ctrl-2": ["workspace::ActivatePane", 1],
      "ctrl-3": ["workspace::ActivatePane", 2],
      "ctrl-4": ["workspace::ActivatePane", 3],
      "ctrl-5": ["workspace::ActivatePane", 4],
      "ctrl-6": ["workspace::ActivatePane", 5],
      "ctrl-7": ["workspace::ActivatePane", 6],
      "ctrl-8": ["workspace::ActivatePane", 7],
      "ctrl-9": ["workspace::ActivatePane", 8],

      "ctrl-shift-h": "vim::ResizePaneLeft",
      "ctrl-shift-j": "vim::ResizePaneDown",
      "ctrl-shift-k": "vim::ResizePaneUp",
      "ctrl-shift-l": "vim::ResizePaneRight",

      "ctrl-alt-shift-h": "workspace::SwapPaneLeft",
      "ctrl-alt-shift-j": "workspace::SwapPaneDown",
      "ctrl-alt-shift-k": "workspace::SwapPaneUp",
      "ctrl-alt-shift-l": "workspace::SwapPaneRight",

      "ctrl-t": "workspace::ToggleBottomDock",

      "ctrl-alt-t": "workspace::NewCenterTerminal",
      "ctrl-alt-o": "workspace::OpenFiles",
      "ctrl-alt-n": "workspace::NewFile",

      "f5": "task::Rerun",

      "ctrl-shift-w": null
    }
  },
  {
    "context": "Editor && (vim_mode == normal || vim_mode == visual)",
    "bindings": {
      "shift-h": ["workspace::SendKeystrokes", "g 0 e l"],
      "shift-l": ["workspace::SendKeystrokes", "g _ h"],
      "shift-s": "vim::PushAddSurrounds",
      "space shift-g": ["task::Spawn", { "task_name": "launch lazygit" }],
      "space shift-j": "journal::NewJournalEntry"
    }
  },
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "space space": "command_palette::Toggle",
      "tab": ["workspace::SendKeystrokes", "shift-v >"],
      "shift-tab": ["workspace::SendKeystrokes", "shift-v <"],
      "ctrl-v": ["workspace::SendKeystrokes", "\" + p"],
      "shift-s": ["workspace::SendKeystrokes", "v v shift-s"],
      "space v": ["workspace::SendKeystrokes", "v space"],
      "s": "outline::Toggle"
    }
  },
  {
    "context": "Editor && vim_mode == visual",
    "bindings": {
      "tab": ["workspace::SendKeystrokes", "> g v"],
      "shift-tab": ["workspace::SendKeystrokes", "< g v"],
      "ctrl-c": ["workspace::SendKeystrokes", "\" + y g v"],
      "v": "vim::SelectLargerSyntaxNode",
      "space": "vim::SelectLargerSyntaxNode"
    }
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "ctrl-v": ["workspace::SendKeystrokes", "escape \" + p"],
      "ctrl-space": "editor::ShowCompletions",
      "ctrl-shift-space": "zeta::PreviewCompletion"
    }
  },
  {
    "context": "(Editor && vim_mode != visual) && !showing_completions",
    "bindings": {
      "ctrl-n": "editor::ShowCompletions"
    }
  },

  {
    "context": "Editor && !menu",
    "bindings": {
      //"ctrl-c": "editor::Copy", // vim default: return to normal mode
      //"ctrl-x": "editor::Cut", // vim default: decrement
      //"ctrl-v": "editor::Paste", // vim default: visual block mode
      "ctrl-y": "vim::Undo", // vim default: line up
      "ctrl-f": "buffer_search::Deploy", // vim default: page down
      //"ctrl-o": "workspace::Open", // vim default: go back
      "ctrl-a": "editor::SelectAll" // vim default: increment
    }
  },
  {
    "context": "ProjectSearchBar",
    "bindings": {
      "escape": "pane::CloseActiveItem"
    }
  },
  {
    "context": "EmptyPane",
    "bindings": {
      "ctrl-shift-w": [
        "workspace::SendKeystrokes",
        ": opensettings enter : openkeymap enter : debugcontext enter"
      ],
      "ctrl-w": "workspace::CloseWindow"
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-p": null,
      //"ctrl-w c": "pane::CloseActiveItem",
      "ctrl-w": "pane::CloseActiveItem",
      "ctrl-t": "workspace::NewTerminal",
      "ctrl-`": "workspace::ToggleBottomDock",
      "alt-escape": "terminal::ToggleViMode",
      "ctrl-shift-t": "workspace::NewCenterTerminal"
    }
  },
  {
    "context": "ProjectPanel",
    "bindings": {
      "alt-l": ["workspace::SendKeystrokes", "ctrl-l alt-l"],
      "alt-h": ["workspace::SendKeystrokes", "ctrl-l alt-h"]
    }
  },
  {
    "context": "Picker > Editor",
    "bindings": {}
  }
]
