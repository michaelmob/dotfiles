// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "context_servers": {
    "Context7": {
      "source": "custom",
      "command": "node",
      "args": [
        "C:\\Users\\Michael\\scoop\\persist\\nodejs\\bin\\node_modules\\@upstash\\context7-mcp\\dist\\index.js"
      ]
    }
  },
  "notification_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "right"
  },
  "project_panel": {
    "dock": "left"
  },
  "features": {
    "edit_prediction_provider": "zed"
  },
  "ui_font_family": "Roboto",
  "ui_font_size": 12,
  "buffer_font_size": 12,
  "buffer_font_family": "JetBrains Mono",
  "relative_line_numbers": true,
  "tab_size": 2,
  "show_whitespaces": "selection",
  "remove_trailing_whitespace_on_save": true,
  "restore_on_startup": "last_session",
  "multi_cursor_modifier": "cmd_or_ctrl",
  "show_signature_help_after_edits": true,
  "icon_theme": "Zed (Default)",
  "line_indicator_format": "short",
  "when_closing_with_no_tabs": "close_window",
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
    "selections_menu": false,
    "agent_review": false,
    "code_actions": false
  },
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Panda"
  },
  "experimental.theme_overrides": {
    "syntax": {
      "comment": {
        "font_style": "italic"
      },
      "comment.doc": {
        "font_style": "italic"
      }
    }
  },
  "journal": {},
  "file_finder": {},
  "tabs": {
    "file_icons": true
  },
  "active_pane_modifiers": {
    // "border_size": 2,
    // "magnification": 1.2
  },
  "wrap_guides": [99],
  "indent_guides": {
    "active_line_width": 2,
    "line_width": 1,
    "coloring": "indent_aware"
  },
  "vim_mode": true,
  "vim": {
    "highlight_on_yank_duration": 1000,
    "use_system_clipboard": "on_yank"
  },
  "git": {
    "git_gutter": null,
    "gutter_debounce": null,
    "inline_blame": {
      "enabled": false
    }
  },
  "agent": {
    "inline_assistant_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-4"
    },
    "always_allow_tool_actions": true,
    "default_profile": "write",
    //"use_modifier_to_send": false,
    //"play_sound_when_agent_done": false,
    // "inline_assistant_model": {
    //   "provider": "openai",
    //   "model": "gpt-5-nano"
    // },
    "default_model": {
      "provider": "google",
      "model": "gemini-2.5-flash"
    }
    // "inline_assistant_model": {
    //   "provider": "openai",
    //   "model": "gpt-5-nano"
    // }
  },
  "languages": {
    "Rust": {
      "tab_size": 4
    }
  }
