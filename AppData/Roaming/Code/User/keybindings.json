[
  // # Editors and Tabs

  // -- Navigate Panes with <c-{h,j,k,l}>
  { "key": "ctrl+h", "command": "workbench.action.focusLeftGroup",  "when": "(editorTextFocus && (activeEditorIsFirstInGroup || multipleEditorGroups)) || activeEditorGroupEmpty" },
  { "key": "ctrl+j", "command": "workbench.action.focusBelowGroup", "when": "editorTextFocus || activeEditorGroupEmpty" },
  { "key": "ctrl+k", "command": "workbench.action.focusAboveGroup", "when": "editorTextFocus || activeEditorGroupEmpty" },
  { "key": "ctrl+l", "command": "workbench.action.focusRightGroup", "when": "(editorTextFocus && (activeEditorIsLastInGroup || multipleEditorGroups)) || activeEditorGroupEmpty" },

  // ## Navigate Editors and Tabs with <Up,Left,Down,Right>
  { "key": "Left",  "command": "workbench.action.previousEditor",  "when": "editorTextFocus && !activeEditorIsFirstInGroup" },
  { "key": "Right",  "command": "workbench.action.nextEditor",      "when": "editorTextFocus && !activeEditorIsLastInGroup" },

  { "key": "Left",  "command": "workbench.action.focusLeftGroup",  "when": "editorTextFocus && activeEditorIsFirstInGroup" },
  { "key": "Right",  "command": "workbench.action.focusRightGroup", "when": "editorTextFocus && activeEditorIsLastInGroup" },
  { "key": "Down", "command": "workbench.action.focusBelowGroup",  "when": "editorTextFocus || activeEditorGroupEmpty" },
  { "key": "Up", "command": "workbench.action.focusAboveGroup",  "when": "editorTextFocus || activeEditorGroupEmpty" },

  // ## Move Tabs with <c-a-{h,j,k,l}>
  { "key": "ctrl+alt+h", "command": "workbench.action.moveEditorToPreviousGroup", "when": "editorTextFocus && activeEditorIsFirstInGroup" },
  { "key": "ctrl+alt+l", "command": "workbench.action.moveEditorToNextGroup",     "when": "editorTextFocus && activeEditorIsLastInGroup" },

  { "key": "ctrl+alt+h", "command": "workbench.action.moveEditorLeftInGroup",  "when": "editorTextFocus && !activeEditorIsFirstInGroup" },
  { "key": "ctrl+alt+j", "command": "workbench.action.moveEditorToBelowGroup", "when": "editorTextFocus && groupEditorsCount > 1" },
  { "key": "ctrl+alt+k", "command": "workbench.action.moveEditorToAboveGroup", "when": "editorTextFocus" },
  { "key": "ctrl+alt+l", "command": "workbench.action.moveEditorRightInGroup", "when": "editorTextFocus && !activeEditorIsLastInGroup" },

  // ## Move Editor Groups with <c-a-{H,J,K,L}>
  { "key": "ctrl+alt+shift+h", "command": "workbench.action.moveActiveEditorGroupLeft",  "when": "editorTextFocus || activeEditorGroupEmpty" },
  { "key": "ctrl+alt+shift+j", "command": "workbench.action.moveActiveEditorGroupDown",  "when": "editorTextFocus || activeEditorGroupEmpty" },
  { "key": "ctrl+alt+shift+k", "command": "workbench.action.moveActiveEditorGroupUp",    "when": "editorTextFocus || activeEditorGroupEmpty" },
  { "key": "ctrl+alt+shift+l", "command": "workbench.action.moveActiveEditorGroupRight", "when": "editorTextFocus || activeEditorGroupEmpty" },
 

  // # Editors
  // ## Swap Editor Groups with <c-a-s-{h,j,k,l}>
  


  // #region Sidebar
  { "key": "ctrl+0", "command": "workbench.action.closeSidebar",           "when": "sideBarFocus" },  // toggle sidebar
  { "key": "ctrl+h", "command": "",                                        "when": "sideBarFocus" },  // deactivate <c-h> in sidebar
  { "key": "ctrl+j", "command": "workbench.action.nextSideBarView",        "when": "sideBarFocus" },  // focus down/next sidebar item with <c-j>
  { "key": "ctrl+k", "command": "workbench.action.previousSideBarView",    "when": "sideBarFocus" },  // focus up/previous sidebar item with <c-k>
  { "key": "ctrl+l", "command": "workbench.action.focusActiveEditorGroup", "when": "sideBarFocus" },  // focus editor with <c-l>
  // #endregion

  
  // #region Empty Editor Group
  { "key": "ctrl+w", "command": "workbench.action.closeGroup", "when": "activeEditorGroupEmpty" },
  // #endregion

  
  //#region Auto-completion, Intellisense, and Suggestion Widget:
  { "key": "ctrl+n", "command": "selectNextSuggestion", "when": "suggestWidgetVisible" /*&& suggestWidgetMultipleSuggestions*/ }, // <c-n> to select NEXT suggestion
  { "key": "ctrl+p", "command": "selectPrevSuggestion", "when": "suggestWidgetVisible && suggestWidgetMultipleSuggestions" }, // <c-p> to select PREV suggestion
  { "key": "escape", "command": "hideSuggestWidget",    "when": "suggestWidgetVisible" }, // Close trigger suggest with <esc>
  //#endregion
  

  // QUICK-OPEN Navigation: Navigate items with <ctrl-{n,p}>
  //{ "key": "ctrl+p", "command": "workbench.action.quickOpen",               "when": "editorTextFocus" },
  { "key": "ctrl+p", "command": "workbench.action.quickOpenSelectPrevious", "when": "inQuickOpen" },
  { "key": "ctrl+n", "command": "workbench.action.quickOpenSelectNext",     "when": "inQuickOpen" },
  { "key": "ctrl+j", "command": "workbench.action.quickOpenSelectNext",     "when": "inQuickOpen" },
  { "key": "ctrl+k", "command": "workbench.action.quickOpenSelectPrevious", "when": "inQuickOpen" },

    
  // #region Terminal
  // Navigate up-and-down terminals are automatically bound to Ctrl+Shift+{j,k}
  { "key": "ctrl+j",    "command": "",                                      "when": "terminalFocus" },  // deactivate <c-j> in terminal
  { "key": "ctrl+k",    "command": "workbench.action.focusLastEditorGroup", "when": "terminalFocus" },  // focus editor with <c-k>
  { "key": "ctrl+w c",  "command": "workbench.action.terminal.kill",        "when": "terminalFocus" },  // quit terminal with <c-w>c

  // -- Launch or toggle terminal visiblity with <c-[s]-t>
  { "key": "ctrl+t",       "command": "workbench.action.terminal.toggleTerminal", "when": "terminalFocus || editorTextFocus || activeEditorGroupEmpty" },
  { "key": "ctrl+shift+t", "command": "workbench.action.terminal.new",            "when": "terminalFocus" },
  { "key": "ctrl+shift+f", "command": "workbench.action.toggleMaximizedPanel",    "when": "terminalFocus" },
  //{ "key": "ctrl+shift+t", "command": "workbench.action.createTerminalEditor",    "when": "editorTextFocus || editorTextFocus || activeEditorGroupEmpty" },
  
  // -- Navigate terminals with <c-s-{j,k}>
  { "key": "ctrl+shift+j", "command": "workbench.action.terminal.focusNext",     "when": "terminalFocus"},
  { "key": "ctrl+shift+k", "command": "workbench.action.terminal.focusPrevious", "when": "terminalFocus"},
  //#endregion
  

  //#region Notifications
  {
    "key": "alt+n",
    "command": "notifications.focusToasts",
    "when": "!inQuickOpen && (!suggestWidgetVisible || notificationToastsVisible)"
  },
  //#endregion

  // Command Palette Keybindings:
  //{ "key": "ctrl+e", "command": "workbench.action.quickOpen", "when": "editorTextFocus" },
  //{ "key": "ctrl+f", "command": "actions.find", "when": "editorTextFocus" },
  //{ "key": "ctrl+f", "command": "runCommands",  "when": "findWidgetVisible && !inputBoxFocus",
  //  "args": { "commands": [ "closeFindWidget", "workbench.action.quickTextSearch" ] } },

  //#region FindItFaster Extension
  { "key": "ctrl+shift+j", "command": "-find-it-faster.findFiles" },
  { "key": "ctrl+shift+u", "command": "-find-it-faster.findWithinFiles" },
  { "key": "ctrl+shift+alt+u", "command": "-find-it-faster.findWithinFilesWithType" },
  //#endregion


  //#region VSVim Extension
  { "key": "ctrl+n", "command": "editor.action.triggerSuggest", "when": "editorTextFocus && vim.mode == 'Insert' && !inCompositeEditor && !suggestWidgetVisible" },
  { "key": "shift+;", "command": "vim.showQuickpickCmdLine", "when": "inZenMode && vim.mode != 'Insert'" },
  //#endregion

]
