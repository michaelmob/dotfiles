{
  // #region Window
  "window.menuBarVisibility": "compact",
  "window.titleBarStyle": "custom",
  "window.customMenuBarAltFocus": false,
  "window.enableMenuBarMnemonics": false,
  // #endregion
  


  // #region Workbench
  "workbench.colorTheme": "GitHub Dark Default",
  "workbench.iconTheme": "catppuccin-mocha",
  "workbench.editor.enablePreviewFromQuickOpen": false,
  "workbench.colorCustomizations": {
    "statusBar.background": "#005f5f",
    "statusBar.noFolderBackground": "#005f5f",
    "statusBar.debuggingBackground": "#005f5f",
    "statusBar.foreground": "#ffffff",
    "statusBar.debuggingForeground": "#ffffff",
    "editorCursor.foreground": "#e9dbb7",
    "activityBarBadge.background": "#e9dbb7",
    "activityBarBadge.foreground": "#262626"
  },
  /*"workbench.colorCustomizations": {
    "editorGhostText.border": "#696969",
    "editorGhostText.foreground": "#696969"
  },*/
  // #endregion


  // #region Editor
  "editor.lineNumbers": "relative",
  "editor.formatOnPaste": true,
  "editor.formatOnSave": false,
  "editor.formatOnType": true,
  "editor.multiCursorModifier": "ctrlCmd",
  "editor.emptySelectionClipboard": false,
  "editor.mouseWheelScrollSensitivity": 5,
  "editor.tabSize": 2,
  "editor.fontSize": 14,
  "editor.fontFamily": "JetBrains Mono Medium",
  "editor.rulers": [ 99 ],
  "editor.minimap.enabled": false,
  "editor.smoothScrolling": true,
  "editor.suggest.preview": true,
  // #endregion



  // #region Breadcrumbs
  "breadcrumbs.enabled": false,
  // #endregion


  // #region Terminal
  "terminal.integrated.sendKeybindingsToShell": true, // <C-a>, <C-f> in term
  // #endregion


  // #region Files
  "files.trimFinalNewlines": true,
  "files.insertFinalNewline": true,
  "files.simpleDialog.enable": true,
  // #endregion


  // #region Telemetry
  "telemetry.telemetryLevel": "off",
  // #endregion


  // #region Git
  "git.autofetch": true,
  "git.openRepositoryInParentFolders": "never",
  // #endregion



  // #region VSVim Extension
  //"vim.mouseSelectionGoesIntoVisualMode": false,
  "vim.leader": "<space>",
  "vim.handleKeys": {
    "<C-p>": false
  },
  "vim.useSystemClipboard": false,
  //"vim.replaceWithRegister": true,
  "vim.highlightedyank.enable": true,
  "vim.visualstar": true,
  "vim.gdefault": true, // enable global search by default
  "vim.camelCaseMotion.enable": true,
  "vim.changeWordIncludesWhitespace": true,
  "vim.surround": true,
  "vim.easymotion": true,
  "vim.easymotionKeys": "wertasdfgqzxcv",
  "vim.sneak": true,
  "vim.sneakUseIgnorecaseAndSmartcase": true,
  "vim.sneakReplacesF": true, // multi-line find-letter key
  "vim.statusBarColorControl": true,
  "vim.insertModeKeyBindings": [
    //{ "before": ["<c-c>"], "after": ["<Esc>"] },
  ],
  "vim.normalModeKeyBindings": [
    { "before": ["E"], "commands": [ "workbench.action.previousEditor" ]},
    { "before": ["R"], "commands": [ "workbench.action.nextEditor" ]},
    { "before": ["u"],     "commands": ["undo"] },
    { "before": ["<C-r>"], "commands": ["redo"] },
    { "before": ["<Space>"],
      "commands": [
        { "command": "_setContext",      "args": [ "leaderkeyState", "SPC" ] },
        { "command": "leaderkey.render", "args": "SPC" }
      ]
    },
  ],
  "vim.normalModeKeyBindingsNonRecursive": [
    { "before": ["J"], "after": [] },
    { "before": ["K"], "after": [] },
    { "before": ["H"], "after": ["^"] }, // goto first non-whitespace character
    { "before": ["L"], "after": ["g", "_"] }, // goto last character
    { "before": ["S"], "after": ["y", "s", "i", "w"] },
    { "before": ["<Enter>"], "after": ["o", "<Esc>"] },
    { "before": ["s"], "after": ["<leader>", "<leader>", "2", "s"] },
  ],
  "vim.visualModeKeyBindingsNonRecursive": [
    { "before": ["Y"], "after": ["\"", "+", "y"] },
    { "before": ["H"], "after": ["^"] }, // goto first non-whitespace character
    { "before": ["L"], "after": ["g", "_"] }, // goto last character
    { "before": ["s"], "after": ["<leader>", "<leader>", "2", "s"] },
    { "before": ["<"], "after": ["<", "g", "v"] },
    { "before": [">"], "after": [">", "g", "v"] },
    { "before": ["<Space>"],
      "commands": [
        { "command": "_setContext", "args": [ "leaderkeyState", "SPC" ] },
        { "command": "leaderkey.render", "args": "SPC" }
      ]
    },
    // { "before": [ "v" ], "commands": [
    //   { "command": "_setContext", "args": [ "leaderkeyState", "SPC", "v:transient" ] },
    //   { "command": "leaderkey.render", "args": "SPC v:transient" } ]
    // },
  ],
  // #endregion


  // #region Leaderkey Extension
  // https://github.com/JimmyZJX/leaderkey/blob/main/src/defaultBindings.ts
  "leaderkey.overrides.user": {
    "SPC y": {
      "name": "Yank to system clipboard",
      "command": "editor.action.clipboardCopyAction",
    },
    "SPC p": {
      "name": "Paste on next line",
      "command": "editor.action.clipboardPasteAction",
    },
    "SPC r": {
      "name": "Show vim registers",
      "command": "vim.remap",
      "args": { "commands": [{ "command": ":registers" }] }
    },
    "SPC f": {
      "name": "ripgrep",
      "command": "ripgrep.findInWorkspace",
    },
    // "SPC v:transient y": {
    //   "name": "Yank selection",
    //   "commands": [
    //     { "command": "vim.remap", "args": { "after": ["y"] } },
    //     { "command": "leaderkey.render", "args": "" },
    //   ]
    // },
    // "SPC v:transient p": {
    //   "name": "Paste over selection",
    //   "commands": [
    //     { "command": "vim.remap", "args": { "after": ["p"] } },
    //     { "command": "leaderkey.render", "args": "" },
    //   ]
    // },
    // "SPC v:transient h": {
    //   "name": "Shrink selection",
    //   "command": "editor.action.smartSelect.shrink"
    // },
    // "SPC v:transient l": {
    //   "name": "Grow selection",
    //   "command": "editor.action.smartSelect.grow"
    // },
    // "SPC v:transient Y": {
    //   "name": "Yank to system clipboard",
    //   "commands": [
    //     { "command": "editor.action.clipboardCopyAction" },
    //     { "command": "leaderkey.render", "args": "" },
    //   ]
    // },
  },
  // #endregion


  // #region Extension
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1
  },
  "svelte.enable-ts-plugin": true,
  "[javascript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "[typescript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "remote.SSH.remotePlatform": {
    "mcm-fedora": "linux"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.formatOnSave": false
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.formatOnSave": false
  },
  "[svelte]": {
    "editor.defaultFormatter": "svelte.svelte-vscode",
    "typescript.autoClosingTags": false,
    "javascript.autoClosingTags": false,
  },
  "html.autoClosingTags": false,
  "AutoHotkey2.InterpreterPath": "c:\\Users\\Michael\\AppData\\Local\\Programs\\AutoHotkey\\v2\\AutoHotkey64.exe",
  // #endregion
}
