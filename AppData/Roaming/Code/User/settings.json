{
  // #region Window
  "window.menuBarVisibility": "toggle",
  // #endregion
 

  // #region Workbench
  "workbench.editor.enablePreviewFromQuickOpen": false,
  /*"workbench.colorCustomizations": {
    "editorGhostText.border": "#696969",
    "editorGhostText.foreground": "#696969"
  },*/
  // #endregion


  // #region Editor
  "editor.lineNumbers": "relative",
  /*"editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "editor.formatOnType": true,*/
  "editor.multiCursorModifier": "ctrlCmd",
  "editor.emptySelectionClipboard": false,
  "editor.mouseWheelScrollSensitivity": 5,
  "editor.tabSize": 2,
  "editor.fontSize": 16,
  "editor.fontFamily": "JetBrains Mono Medium",
  "editor.rulers": [ 99 ],
  "editor.minimap.enabled": false,
  "editor.smoothScrolling": true,
  "editor.suggest.preview": true,
  // #endregion



  // #region Breadcrumbs
  "breadcrumbs.enabled": false,
  // #endregion


  // #region Terminal
  /*"terminal.integrated.sendKeybindingsToShell": true, // <C-a>, <C-f> in term*/

  // #endregion


  // #region Files
  "files.trimFinalNewlines": true,
  "files.insertFinalNewline": true,
  "files.simpleDialog.enable": true,
  // #endregion


  // #region Telemetry
  "telemetry.telemetryLevel": "off",
  // #endregion


  // #region Git
  "git.autofetch": true,
  "git.openRepositoryInParentFolders": "never",
  // #endregion


  // #region Extension
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1
  },
  "workbench.iconTheme": "catppuccin-mocha",
  // #endregion


  // #region VSCode Neovim Extension
  /*"vscode-neovim.neovimExecutablePaths.win32": "./bin/nvim-win64/bin/nvim.exe",
  "vscode-neovim.neovimInitVimPaths.win32": "./_config/nvim/init.lua"*/
  // #endregion
}
