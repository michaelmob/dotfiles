{
  // #region Window
  //"window.menuBarVisibility": "compact",
  //"window.titleBarStyle": "custom",
  //"window.custommenubaraltfocus": false,
  //"window.enablemenubarmnemonics": false,
  // #endregion
  


  // #region Workbench
  "workbench.startupEditor": "readme",
  "workbench.editor.enablePreviewFromQuickOpen": false,
  // #endregion


  // #region Editor
  "editor.lineNumbers": "relative",
  "editor.formatOnPaste": true,
  "editor.formatOnSave": false,
  "editor.formatOnType": true,
  "editor.multiCursorModifier": "ctrlCmd",
  "editor.emptySelectionClipboard": false,
  "editor.mouseWheelScrollSensitivity": 5,
  "editor.tabSize": 2,
  "editor.fontSize": 14,
  "editor.fontFamily": "JetBrains Mono Medium",
  "editor.rulers": [ 99 ],
  "editor.minimap.enabled": false,
  "editor.smoothScrolling": true,
  "editor.suggest.preview": true,
  // #endregion



  // #region Breadcrumbs
  "breadcrumbs.enabled": false,
  // #endregion


  // #region Terminal
  "terminal.integrated.sendKeybindingsToShell": true, // <C-a>, <C-f> in term
  // #endregion


  // #region Files
  "files.trimFinalNewlines": true,
  "files.insertFinalNewline": true,
  "files.simpleDialog.enable": true,
  "files.associations": {
    "*.svelte.ts": "typescript",
  },
  // #endregion


  // #region Telemetry
  "telemetry.telemetryLevel": "off",
  // #endregion


  // #region Git
  "git.autofetch": true,
  "git.openRepositoryInParentFolders": "never",
  // #endregion



  // #region VSVim Extension
  //"vim.mouseSelectionGoesIntoVisualMode": false,
  "vim.leader": "<space>",
  "vim.handleKeys": {
    "<C-p>": false,
    "<C-f>": false,
    "<>": false
  },
  "vim.useSystemClipboard": false,
  //"vim.replaceWithRegister": true,
  "vim.highlightedyank.enable": true,
  "vim.visualstar": true,
  "vim.gdefault": true, // enable global search by default
  "vim.camelCaseMotion.enable": true,
  "vim.changeWordIncludesWhitespace": true,
  "vim.surround": true,
  "vim.easymotion": true,
  "vim.easymotionKeys": "wertasdfgqzxcv",
  "vim.sneak": true,
  "vim.sneakUseIgnorecaseAndSmartcase": true,
  "vim.sneakReplacesF": true, // multi-line find-letter key
  "vim.insertModeKeyBindings": [
    //{ "before": ["<c-c>"], "after": ["<Esc>"] },
  ],
  "vim.normalModeKeyBindings": [
    { "before": ["E"], "commands": [ "workbench.action.previousEditor" ]},
    { "before": ["R"], "commands": [ "workbench.action.nextEditor" ]},
    { "before": ["u"],     "commands": ["undo"] },
    { "before": ["<C-r>"], "commands": ["redo"] },
    { "before": ["S"], "after": ["y", "s", "i", "w"] },
    { "before": ["<Space>"],
      "commands": [
        { "command": "_setContext",      "args": [ "leaderkeyState", "SPC" ] },
        { "command": "leaderkey.render", "args": "SPC" }
      ]
    },
  ],
  "vim.normalModeKeyBindingsNonRecursive": [
    { "before": ["J"], "after": [] },
    { "before": ["K"], "after": [] },
    { "before": ["H"], "after": ["^"] }, // goto first non-whitespace character
    { "before": ["L"], "after": ["g", "_"] }, // goto last character
    { "before": ["s"], "after": ["<leader>", "<leader>", "2", "s"] },
    { "before": ["<Enter>"], "after": ["o", "<Esc>"] },
  ],
  "vim.visualModeKeyBindingsNonRecursive": [
    { "before": ["Y"], "after": ["\"", "+", "y"] },
    { "before": ["H"], "after": ["^"] }, // goto first non-whitespace character
    { "before": ["L"], "after": ["g", "_"] }, // goto last character
    { "before": ["s"], "after": ["<leader>", "<leader>", "2", "s"] },
    { "before": ["<"], "after": ["<", "g", "v"] },
    { "before": [">"], "after": [">", "g", "v"] },
    { "before": ["<Space>"],
      "commands": [
        { "command": "_setContext", "args": [ "leaderkeyState", "SPC" ] },
        { "command": "leaderkey.render", "args": "SPC" }
      ]
    },
    // { "before": [ "v" ], "commands": [
    //   { "command": "_setContext", "args": [ "leaderkeyState", "SPC", "v:transient" ] },
    //   { "command": "leaderkey.render", "args": "SPC v:transient" } ]
    // },
  ],
  // #endregion


  // #region Leaderkey Extension
  "leaderkey.fzf.exe": "fzf",
  "leaderkey.ripgrep.exe": "rg",
  // https://github.com/JimmyZJX/leaderkey/blob/main/src/defaultBindings.ts
  "leaderkey.overrides.user": {
    "SPC w c": {
      "name": "Close window pane",
      "command": "",
    },
    "SPC y": {
      "name": "Yank to system clipboard",
      //"command": "editor.action.clipboardCopyAction",
      "command": "vim.remap",
      "args": { "after": ["\"", "+", "y"] }
    },
    // "SPC p": {
    //   "name": "Paste on next line",
    //   "command": "editor.action.clipboardPasteAction",
    // },
    "SPC R": {
      "name": "Show vim registers",
      "command": "vim.remap",
      "args": {
        "commands": [{ "command": ":registers" }]
      }
    },
    "SPC SPC": {
      "name": "ripgrep",
      "command": "leaderkey.ripgrep",
      "args": {
        "dir": {"type": "workspace"},
        "query": { "type": "current" }
      }
    },
    // "SPC f": {
    //   "name": "ripgrep",
    //   "command": "ripgrep.findInWorkspace",
    // },
    // "SPC v:transient y": {
    //   "name": "Yank selection",
    //   "commands": [
    //     { "command": "vim.remap", "args": { "after": ["y"] } },
    //     { "command": "leaderkey.render", "args": "" },
    //   ]
    // },
    // "SPC v:transient p": {
    //   "name": "Paste over selection",
    //   "commands": [
    //     { "command": "vim.remap", "args": { "after": ["p"] } },
    //     { "command": "leaderkey.render", "args": "" },
    //   ]
    // },
    // "SPC v:transient h": {
    //   "name": "Shrink selection",
    //   "command": "editor.action.smartSelect.shrink"
    // },
    // "SPC v:transient l": {
    //   "name": "Grow selection",
    //   "command": "editor.action.smartSelect.grow"
    // },
    // "SPC v:transient Y": {
    //   "name": "Yank to system clipboard",
    //   "commands": [
    //     { "command": "editor.action.clipboardCopyAction" },
    //     { "command": "leaderkey.render", "args": "" },
    //   ]
    // },
  },
  // #endregion


  // #region Extension
  "AutoHotkey2.InterpreterPath": "c:\\Users\\Michael\\AppData\\Local\\Programs\\AutoHotkey\\v2\\AutoHotkey64.exe",
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1
  },
  "svelte.enable-ts-plugin": true,
  "[javascript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "[typescript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.formatOnSave": false
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.formatOnSave": false
  },
  "[svelte]": {
    "editor.quickSuggestions": {
      "other": "on",
      "comments": "off",
      "strings": "off"
    },
    "editor.defaultFormatter": "svelte.svelte-vscode",
    // "typescript.autoClosingTags": false,
    // "javascript.autoClosingTags": false,
  },
  "remote.SSH.remotePlatform": {"mcm-fedora":"linux","coder-vscode.docker1--michaelmob--blue-rabbit-22":"linux","coder-vscode.docker1--michaelmob--blue-rabbit-22.main":"linux"},
  "remote.SSH.connectTimeout": 1800,
  "git.enableSmartCommit": true,
  "git.confirmSync": false,
  "workbench.sideBar.location": "right",
  "vscode-openai.serviceProvider": "OpenAI",
  "vscode-openai.baseUrl": "https://api.openai.com/v1",
  "vscode-openai.defaultModel": "gpt-4.1-mini",
  "vscode-openai.azureDeployment": "setup-required",
  "vscode-openai.scmModel": "gpt-4.1-mini",
  "vscode-openai.scmDeployment": "setup-required",
  "vscode-openai.embeddingModel": "text-embedding-3-small",
  "vscode-openai.embeddingsDeployment": "setup-required",
  "vscode-openai.azureApiVersion": "2024-06-01",
  "github.copilot.advanced": {

  },
  "roo-cline.allowedCommands": [
    "git log",
    "git diff",
    "git show"
  ],
  "roo-cline.deniedCommands": [],
  "chat.mcp.autostart": "onlyNew",
  "inlineChat.finishOnType": true,
  "chat.editor.fontSize": 16,
  "chat.fontSize": 16,
  "terminal.integrated.stickyScroll.enabled": false,
  // "inlineChat.enableV2": true,
  // "inlineChat.holdToSpeech": false,
  // "inlineChat.lineEmptyHint": true,
  // #endregion
}
