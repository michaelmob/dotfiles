{
  // #region Window
  "window.menuBarVisibility": "compact",
  "window.titleBarStyle": "custom",
  "window.customMenuBarAltFocus": false,
  "window.enableMenuBarMnemonics": false,
  // #endregion

 

  // #region Workbench
  "workbench.iconTheme": "catppuccin-mocha",
  "workbench.editor.enablePreviewFromQuickOpen": false,
  /*"workbench.colorCustomizations": {
    "editorGhostText.border": "#696969",
    "editorGhostText.foreground": "#696969"
  },*/
  // #endregion

  // #region Editor
  "editor.lineNumbers": "relative",
  "editor.formatOnPaste": true,
  "editor.formatOnSave": false,
  "editor.formatOnType": true,
  "editor.multiCursorModifier": "ctrlCmd",
  "editor.emptySelectionClipboard": false,
  "editor.mouseWheelScrollSensitivity": 5,
  "editor.tabSize": 2,
  "editor.fontSize": 14,
  "editor.fontFamily": "JetBrains Mono Medium",
  "editor.rulers": [ 99 ],
  "editor.minimap.enabled": false,
  "editor.smoothScrolling": true,
  "editor.suggest.preview": true,
  // #endregion



  // #region Breadcrumbs
  "breadcrumbs.enabled": false,
  // #endregion


  // #region Terminal
  "terminal.integrated.sendKeybindingsToShell": true, // <C-a>, <C-f> in term
  // #endregion


  // #region Files
  "files.trimFinalNewlines": true,
  "files.insertFinalNewline": true,
  "files.simpleDialog.enable": true,
  // #endregion


  // #region Telemetry
  "telemetry.telemetryLevel": "off",
  // #endregion


  // #region Git
  "git.autofetch": true,
  "git.openRepositoryInParentFolders": "never",
  // #endregion



  // #region VSVim Extension
  //"vim.mouseSelectionGoesIntoVisualMode": false,
  "vim.leader": "<space>",
  "vim.handleKeys": {
    "<C-p>": false
  },
  //"vim.useSystemClipboard": false,
  //"vim.replaceWithRegister": true,
  //"vim.visualstar": true,
  //"vim.gdefault": true, // enable global search by default
  //"vim.camelCaseMotion.enable": true,
  //"vim.surround": true,
  //"vim.easymotion": true,
  //"vim.easymotionKeys": "wertasdfgqzxcv",
  //"vim.sneak": true,
  //"vim.sneakUseIgnorecaseAndSmartcase": true,
  //"vim.sneakReplacesF": true, // multi-line find-letter key
  "vim.insertModeKeyBindings": [
    { "before": ["<c-c>"], "after": ["<Esc>"] },
  ],
  "vim.normalModeKeyBindingsNonRecursive": [
    { "before": ["<c-n>"], "after": ["a", "<c-n>"] }, // goto last character
    { "before": ["L"], "after": ["g", "_"] }, // goto last character
    { "before": ["H"], "after": ["^"] }, // goto first non-whitespace character
    { "before": ["s"], "after": ["leader", "leader", "2", "s"] },
    { "before": [ "<space>" ], "commands": [
      { "command": "_setContext", "args": [ "leaderkeyState", "SPC" ] },
      { "command": "leaderkey.render", "args": "SPC" } ]
    },
    { "before": [ "," ], "commands": [
      { "command": "_setContext", "args": [ "leaderkeyState", "," ] },
      { "command": "leaderkey.render", "args": "," } ]
    },
  ],
  "vim.visualModeKeyBindings": [
    { "before": [ "v" ], "commands": [
      { "command": "leaderkey.render", "args": "SPC v:transient" },
    ]},
  ],
  "vim.visualModeKeyBindingsNonRecursive": [
    { "before": ["<"], "after": ["<", "g", "v"] },
    { "before": [">"], "after": [">", "g", "v"] },
    { "before": ["<Esc>"], "after": ["<Esc>", "<Esc>"] },
    { "before": [ "<space>" ], "commands": [
      { "command": "_setContext", "args": [ "leaderkeyState", "SPC" ] },
      { "command": "leaderkey.render", "args": "SPC" } ]
    },
    { "before": [ "," ], "commands": [
      { "command": "_setContext", "args": [ "leaderkeyState", "," ] },
      { "command": "leaderkey.render", "args": "," } ]
    },
  ],
  // #endregion


  // #region Leaderkey Extension
  // https://github.com/JimmyZJX/leaderkey/blob/main/src/defaultBindings.ts
  "leaderkey.overrides.user": {
    "SPC f f": {
      "name": "fzf files",
      "command": "find-it-faster.findFiles",
    },
    "SPC f F": {
      "name": "Open file/folder (remap)",
      "command": "file-browser.open",
    },
    "SPC s s": {
      "name": "fzf in the current buffer",
      "command": "find-it-faster.findWithinFiles"
    },
    "SPC s S": {
      "name": "Fuzzy search in current buffer (remap)",
      "command": "fuzzySearch.activeTextEditorWithCurrentSelection",
    },
    // "SPC f F": {
    //   "name": "",
    //   "commands": [ "find-it-faster.findWithinFiles" ]
    // },
    // "SPC f f": {
    //   "name": "fzf in the current buffer",
    //   "commands": [ "find-it-faster.findWithinFiles" ]
    // },
  },
  // #endregion


  // #region Extension
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1
  },
  "svelte.enable-ts-plugin": true,
  "[javascript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "[typescript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "workbench.colorTheme": "Monokai One Dark Vivid",
  "remote.SSH.remotePlatform": {
    "mcm-fedora": "linux"
  },
  // #endregion
}
